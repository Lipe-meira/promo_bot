{
  "name": "promo-web",
  "version": "0.1.0",
  "private": true,
  "description": "Web app of the Promo Bot SaaS: sign-in, workspace onboarding, dashboard and settings.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:api": "openapi-typescript ../api/openapi.json -o src/lib/api/schema.d.ts",
    "check:api": "node scripts/check-api-types.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.10.0",
    "@clerk/ui": "^1.42.6",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.0",
    "vitest": "^5.1.0"
  }
}
